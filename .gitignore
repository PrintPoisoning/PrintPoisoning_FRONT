.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo

# storybook
*storybook.log
storybook-static

# editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea

# backup of previous Next.js project
/dump
