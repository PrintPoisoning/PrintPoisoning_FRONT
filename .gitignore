# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# vite
/dist
/dist-ssr
/.vite
*.local

# testing
/coverage

